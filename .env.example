# Resend — see docs/OPEN_QUESTIONS.md Q10 (destination inbox is unresolved)
RESEND_API_KEY=
# Inbox that receives inquiries
INQUIRY_TO_EMAIL=
# Verified sender, e.g. "Portfolio <inquiry@yourdomain.com>". Defaults to Resend's onboarding sender.
INQUIRY_FROM_EMAIL=

# Analytics (production only; leave empty to disable). See docs/OPEN_QUESTIONS.md Q12.
# Umami: full script URL (cloud: https://cloud.umami.is/script.js) and website ID
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Microsoft Clarity project ID (also enables the cookie banner)
NEXT_PUBLIC_CLARITY_ID=
